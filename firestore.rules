rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    // Checks that only the listed fields changed (nothing else was added/removed)
    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // A counter may only move by 1 in either direction and never below 0
    function counterOk(f) {
      return request.resource.data.get(f, 0) is int
        && request.resource.data.get(f, 0) >= 0
        && request.resource.data.get(f, 0) - resource.data.get(f, 0) <= 1
        && request.resource.data.get(f, 0) - resource.data.get(f, 0) >= -1;
    }

    // Counter-only update (like/reply/repost/bookmark counts)
    function isCounterUpdate() {
      return onlyChanged(['likeCount','replyCount','repostCount','bookmarkCount'])
        && counterOk('likeCount') && counterOk('replyCount')
        && counterOk('repostCount') && counterOk('bookmarkCount');
    }

    // Optional string field must stay within a size limit when present
    function strMax(f, n) {
      return !(f in request.resource.data)
        || (request.resource.data[f] is string && request.resource.data[f].size() <= n);
    }

    // Poll vote: only the voter's own entry in poll.votes may change,
    // the chosen index must be valid, and nothing else in the poll moves
    function isPollVote() {
      return onlyChanged(['poll'])
        && request.resource.data.poll.keys().hasOnly(resource.data.poll.keys())
        && resource.data.poll.keys().hasOnly(request.resource.data.poll.keys())
        && request.resource.data.poll.options == resource.data.poll.options
        && request.resource.data.poll.get('votes', {})
             .diff(resource.data.poll.get('votes', {}))
             .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.poll.votes[request.auth.uid] is int
        && request.resource.data.poll.votes[request.auth.uid] >= 0
        && request.resource.data.poll.votes[request.auth.uid] < resource.data.poll.options.size();
    }

    // Site admin (full) vs operator (reply / like / chat only).
    // Membership is written only from the Console or Admin API — no client
    // writes. Legacy admins/{uid} docs with no role stay full admin.
    // Operator: admins/{uid} { role: 'operator' }. Do not give the operator
    // isAdmin() powers (invite rotation, post delete, config writes).
    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminDoc().get('role', 'admin') == 'admin';
    }
    function isOperator() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminDoc().get('role', 'admin') == 'operator';
    }
    function isReplyToExisting() {
      return request.resource.data.parentId is string
        && request.resource.data.parentId.size() > 0
        && request.resource.data.parentId.size() <= 128
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.parentId));
    }
    function isOperatorLikeOrReplyCount() {
      return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['likeCount', 'replyCount'])
        && counterOk('likeCount') && counterOk('replyCount');
    }

    // Unread-count-only update on conversations
    function isUnreadUpdate() {
      return onlyChanged(['unreadCounts','lastMessage','lastMessageAt','lastMessageBy','participantNames']);
    }

    // Public profile docs cannot hide a field. Never persist email, lastSeen,
    // or location here. Leftover values must be deleted from the Console
    // after deploy — see scripts/wipe-public-pii.md.
    function noSensitiveProfile() {
      return !('email' in request.resource.data)
        && !('lastSeen' in request.resource.data)
        && !('location' in request.resource.data);
    }

    // ── Invite gate ───────────────────────────────────────────────────────────
    // config/invite.code is readable by get() so the GitHub Pages client can
    // check it before Auth create. list is denied. Writes are admin-only.
    // Security is obscurity + rotation: set the code in the Console after
    // merge. Do not commit a live code.
    match /config/{docId} {
      allow get: if docId == 'invite';
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Public read (needed for chat user search by displayName).
    // Only the owner can write their own document (plus follower-count bumps).
    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && !('role' in request.resource.data)
        && !('admin' in request.resource.data)
        && noSensitiveProfile()
        && strMax('displayName', 100)
        && strMax('displayNameLower', 100)
        && strMax('bio', 500)
        && strMax('website', 200);
      allow update: if request.auth != null && (
        // Owner edits their own profile
        (request.auth.uid == uid
          && !('role' in request.resource.data)
          && !('admin' in request.resource.data)
          && noSensitiveProfile()
          && strMax('displayName', 100)
          && strMax('displayNameLower', 100)
          && strMax('bio', 500)
          && strMax('website', 200))
        ||
        // Follow/unfollow: any signed-in user may bump followersCount by 1
        // (operator cannot follow, so they cannot bump this either)
        (onlyChanged(['followersCount']) && counterOk('followersCount') && !isOperator())
      );
      allow delete: if false; // never delete user docs
    }

    // ── Posts ─────────────────────────────────────────────────────────────────
    // Public read. Auth users create their own posts.
    // Counter updates allowed by any auth user (likes etc).
    // Only author can delete.
    match /posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        // Must have text, an image, or a poll
        && (request.resource.data.text.size() > 0
            || 'imageUrl' in request.resource.data
            || 'poll' in request.resource.data)
        // Image URLs must point at our Firebase Storage bucket
        && (!('imageUrl' in request.resource.data)
            || (request.resource.data.imageUrl is string
                && request.resource.data.imageUrl.matches('https://firebasestorage[.]googleapis[.]com/.*')))
        && strMax('authorName', 100)
        // Operator may only create replies, not top-level posts
        && (!isOperator() || isReplyToExisting());

      allow update: if request.auth != null && (
        // Author edits their own post (operator: replies only)
        (resource.data.authorUid == request.auth.uid
          && (!isOperator() || 'parentId' in resource.data && resource.data.parentId is string))
        ||
        // Regular users may bump any interaction counters
        (!isOperator() && isCounterUpdate())
        ||
        // Operator may only change likeCount / replyCount
        (isOperator() && isOperatorLikeOrReplyCount())
        ||
        // Regular authenticated users may cast/change their own poll vote
        (!isOperator() && isPollVote())
      );

      // Author or a site admin may delete. Operator cannot delete anyone.
      allow delete: if request.auth != null
        && !isOperator()
        && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // ── Admins / operators ────────────────────────────────────────────────────
    // Full admin: { role: 'admin' } or legacy doc with no role. Console-only.
    // Operator:   { role: 'operator' } written via Admin API after merge.
    // A signed-in user may read only their own membership doc (for UI).
    // Nobody can list or write from the client — not even isAdmin().
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // ── Interactions ──────────────────────────────────────────────────────────
    // Doc ID pattern: "{uid}_{postId}".
    // Only the user whose UID prefixes the document may read/write it.
    match /interactions/{docId} {
      allow read, write: if request.auth != null
        && docId.matches(request.auth.uid + '_[^_]+');
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    // Owner reads, updates (mark-read), and deletes their own items.
    // Create is not "any auth → any uid": fromUid must be the signer, type is
    // allowlisted, keys are locked, and like/reply may only target the author
    // of posts/{postId}.
    function notifKeysOk() {
      return request.resource.data.keys()
        .hasOnly(['type','fromUid','fromName','pageId','postId','excerpt','read','createdAt']);
    }

    function optionalStrMax(f, n) {
      return !(f in request.resource.data)
        || (request.resource.data[f] is string && request.resource.data[f].size() <= n);
    }

    function likeOrReplyToAuthor(recipientUid) {
      return request.resource.data.type in ['like','reply']
        && request.resource.data.postId is string
        && request.resource.data.postId.size() > 0
        && request.resource.data.postId.size() <= 128
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
        && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.authorUid == recipientUid
        && request.auth.uid != recipientUid;
    }

    match /notifications/{uid}/items/{itemId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromName is string
        && request.resource.data.type in ['like','reply','follow','message']
        && request.resource.data.read == false
        && notifKeysOk()
        && strMax('fromName', 100)
        && optionalStrMax('excerpt', 300)
        && optionalStrMax('pageId', 100)
        && (
          likeOrReplyToAuthor(uid)
          ||
          (request.resource.data.type == 'message'
            && request.auth.uid != uid)
          ||
          (request.resource.data.type == 'follow'
            && !isOperator()
            && request.auth.uid != uid)
        );
    }

    // ── Conversations ─────────────────────────────────────────────────────────
    // Only participants may read/write the conversation document.
    // Only participants may read/write messages inside it.
    match /conversations/{convId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;

      // Operator may reply in existing threads, not start new ones
      allow create: if request.auth != null
        && !isOperator()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;

      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && (
          // Sending a message updates last-message metadata + unread counts
          isUnreadUpdate()
          ||
          // Participant resets their own unread count
          onlyChanged(['unreadCounts'])
        );

      allow delete: if false;

      match /messages/{msgId} {
        function conv() {
          return get(/databases/$(database)/documents/conversations/$(convId)).data;
        }

        // A brand-new thread has no conversation doc yet — reading its
        // (empty) messages is harmless and required for the live listener
        allow read: if request.auth != null
          && (!exists(/databases/$(database)/documents/conversations/$(convId))
              || request.auth.uid in conv().participants);

        // getAfter: the first message is batched together with the
        // conversation doc creation, so check post-batch state
        allow create: if request.auth != null
          && request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(convId)).data.participants
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          // A message must have text or a photo from our Storage bucket
          && (request.resource.data.text.size() > 0
              || (request.resource.data.imageUrl is string
                  && request.resource.data.imageUrl.matches('https://firebasestorage[.]googleapis[.]com/.*')))
          && (!('imageUrl' in request.resource.data)
              || (request.resource.data.imageUrl is string
                  && request.resource.data.imageUrl.matches('https://firebasestorage[.]googleapis[.]com/.*')));

        allow update, delete: if false;
      }
    }

    // ── Follows ───────────────────────────────────────────────────────────────
    // follows/{uid}/following/{targetUid}
    //   — public read, only uid can write (they control who they follow)
    // follows/{uid}/followers/{followerUid}
    //   — public read, only followerUid can write (they write themselves into your followers)
    match /follows/{uid}/following/{targetUid} {
      allow read: if true;
      allow write: if request.auth != null
        && !isOperator()
        && request.auth.uid == uid;
    }

    match /follows/{uid}/followers/{followerUid} {
      allow read: if true;
      allow write: if request.auth != null
        && !isOperator()
        && request.auth.uid == followerUid;
    }
  }
}
