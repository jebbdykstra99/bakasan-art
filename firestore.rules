rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    // Checks that only the listed fields changed (nothing else was added/removed)
    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // A counter may only move by 1 in either direction and never below 0
    function counterOk(f) {
      return request.resource.data.get(f, 0) is int
        && request.resource.data.get(f, 0) >= 0
        && request.resource.data.get(f, 0) - resource.data.get(f, 0) <= 1
        && request.resource.data.get(f, 0) - resource.data.get(f, 0) >= -1;
    }

    // Counter-only update (like/reply/repost/bookmark counts)
    function isCounterUpdate() {
      return onlyChanged(['likeCount','replyCount','repostCount','bookmarkCount'])
        && counterOk('likeCount') && counterOk('replyCount')
        && counterOk('repostCount') && counterOk('bookmarkCount');
    }

    // Optional string field must stay within a size limit when present
    function strMax(f, n) {
      return !(f in request.resource.data)
        || (request.resource.data[f] is string && request.resource.data[f].size() <= n);
    }

    // Poll vote: only the voter's own entry in poll.votes may change,
    // the chosen index must be valid, and nothing else in the poll moves
    function isPollVote() {
      return onlyChanged(['poll'])
        && request.resource.data.poll.keys().hasOnly(resource.data.poll.keys())
        && resource.data.poll.keys().hasOnly(request.resource.data.poll.keys())
        && request.resource.data.poll.options == resource.data.poll.options
        && request.resource.data.poll.get('votes', {})
             .diff(resource.data.poll.get('votes', {}))
             .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.poll.votes[request.auth.uid] is int
        && request.resource.data.poll.votes[request.auth.uid] >= 0
        && request.resource.data.poll.votes[request.auth.uid] < resource.data.poll.options.size();
    }

    // Site admin: has a doc in /admins/{uid}, which can only be created
    // from the Firebase Console (no client writes allowed)
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Unread-count-only update on conversations
    function isUnreadUpdate() {
      return onlyChanged(['unreadCounts','lastMessage','lastMessageAt','lastMessageBy','participantNames']);
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Public read (needed for chat user search).
    // Only the owner can write their own document.
    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && !('role' in request.resource.data)
        && !('admin' in request.resource.data)
        && strMax('displayName', 100)
        && strMax('displayNameLower', 100)
        && strMax('bio', 500)
        && strMax('location', 100)
        && strMax('website', 200);
      allow update: if request.auth != null && (
        // Owner edits their own profile
        (request.auth.uid == uid
          && !('role' in request.resource.data)
          && !('admin' in request.resource.data)
          && strMax('displayName', 100)
          && strMax('displayNameLower', 100)
          && strMax('bio', 500)
          && strMax('location', 100)
          && strMax('website', 200))
        ||
        // Follow/unfollow: any signed-in user may bump followersCount by 1
        (onlyChanged(['followersCount']) && counterOk('followersCount'))
      );
      allow delete: if false; // never delete user docs
    }

    // ── Posts ─────────────────────────────────────────────────────────────────
    // Public read. Auth users create their own posts.
    // Counter updates allowed by any auth user (likes etc).
    // Only author can delete.
    match /posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        // Must have text, an image, or a poll
        && (request.resource.data.text.size() > 0
            || 'imageUrl' in request.resource.data
            || 'poll' in request.resource.data)
        // Image URLs must point at our Firebase Storage bucket
        && (!('imageUrl' in request.resource.data)
            || (request.resource.data.imageUrl is string
                && request.resource.data.imageUrl.matches('https://firebasestorage[.]googleapis[.]com/.*')))
        && strMax('authorName', 100);

      allow update: if request.auth != null && (
        // Author edits their own post (text, etc.)
        resource.data.authorUid == request.auth.uid
        ||
        // Any authenticated user may bump counters only
        isCounterUpdate()
        ||
        // Any authenticated user may cast/change their own poll vote
        isPollVote()
      );

      // Author or a site admin may delete (moderation)
      allow delete: if request.auth != null
        && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // ── Admins ────────────────────────────────────────────────────────────────
    // Membership managed ONLY from the Firebase Console. A signed-in user may
    // check their own membership; nobody can list or write from the client.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // ── Interactions ──────────────────────────────────────────────────────────
    // Doc ID pattern: "{uid}_{postId}".
    // Only the user whose UID prefixes the document may read/write it.
    match /interactions/{docId} {
      allow read, write: if request.auth != null
        && docId.matches(request.auth.uid + '_[^_]+');
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    // Owner reads, updates (mark-read), and deletes their own items.
    // Any authenticated user may create a notification for any other user.
    // (Rate-limiting is handled at the application layer.)
    match /notifications/{uid}/items/{itemId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == uid;

      allow create: if request.auth != null
        // Must supply required fields; fromUid must match the creator
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.type in ['like','reply','follow','message']
        && request.resource.data.read == false
        && strMax('fromName', 100)
        && strMax('excerpt', 300)
        && strMax('pageId', 100);
    }

    // ── Conversations ─────────────────────────────────────────────────────────
    // Only participants may read/write the conversation document.
    // Only participants may read/write messages inside it.
    match /conversations/{convId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;

      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && (
          // Sending a message updates last-message metadata + unread counts
          isUnreadUpdate()
          ||
          // Participant resets their own unread count
          onlyChanged(['unreadCounts'])
        );

      allow delete: if false;

      match /messages/{msgId} {
        function conv() {
          return get(/databases/$(database)/documents/conversations/$(convId)).data;
        }

        // A brand-new thread has no conversation doc yet — reading its
        // (empty) messages is harmless and required for the live listener
        allow read: if request.auth != null
          && (!exists(/databases/$(database)/documents/conversations/$(convId))
              || request.auth.uid in conv().participants);

        allow create: if request.auth != null
          && request.auth.uid in conv().participants
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;

        allow update, delete: if false;
      }
    }

    // ── Follows ───────────────────────────────────────────────────────────────
    // follows/{uid}/following/{targetUid}
    //   — public read, only uid can write (they control who they follow)
    // follows/{uid}/followers/{followerUid}
    //   — public read, only followerUid can write (they write themselves into your followers)
    match /follows/{uid}/following/{targetUid} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid;
    }

    match /follows/{uid}/followers/{followerUid} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == followerUid;
    }
  }
}
